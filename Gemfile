source "https://rubygems.org"

# GitHub Pages builds this for us in CI; the gem is here so `bundle exec jekyll serve`
# reproduces the exact same versions locally.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-feed"
end

gem "webrick", "~> 1.8"
